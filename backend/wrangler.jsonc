{
  // L'API du capitaine : un Worker Cloudflare et sa base D1.
  "name": "pirate-can-focus-too-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // L'adresse publique de l'API (domaine géré par Cloudflare).
  "routes": [{ "pattern": "yaawwwk-pirate-can-focus-too.helveticademia.ch", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pirate-can-focus-db",
      "database_id": "c3a03cd3-029a-404a-b963-9155346e3587",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Identifiants OAuth Google acceptés (séparés par des virgules) : le client Android et le client Web.
    "GOOGLE_CLIENT_IDS": "",
    // Expéditeur des codes de connexion (domaine vérifié chez Resend).
    "EMAIL_FROM": "Le Capitaine <capitaine@example.com>"
  }
  // Secret à définir avec `npx wrangler secret put RESEND_API_KEY`.
}
